# Copiez ce fichier en .env puis renseignez vos propres valeurs (.env n'est jamais versionné).
DB_NAME=procurement_db
DB_USERNAME=procurement
DB_PASSWORD=change-me
# Secret de signature JWT (HS256) : au moins 32 caractères aléatoires, ex. `openssl rand -base64 48`
JWT_SECRET=change-me-with-at-least-32-random-characters
# Optionnel : active le module Text-to-Dashboard
GEMINI_API_KEY=
